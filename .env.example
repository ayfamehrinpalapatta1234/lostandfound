# =====================================================================
# TraceBack Environment Configuration
# =====================================================================

PORT=5000
NODE_ENV=development

# Session & JWT Configuration
JWT_SECRET=super_secret_traceback_jwt_key_2026_change_in_production
SESSION_EXPIRY=7d

# Database Configuration (options: sqlite, mysql, postgres)
DB_TYPE=sqlite
DB_FILE=./data/traceback.db

# Optional MySQL Configuration (if connecting to MySQL 8.0)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=traceback_db

# Optional Supabase Configuration (if using Supabase)

SUPABASE_URL=https://your-project.supabase.co

SUPABASE_SECRET_KEY=your-server-only-secret-key
